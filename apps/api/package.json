    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "luxon": "^3.7.2",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
