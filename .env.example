NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=../../data/gatecheck.sqlite
PUBLIC_ORIGIN=http://localhost:5173
# Generate each secret independently: openssl rand -hex 32
QR_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-another-32-random-characters
ADMIN_EMAIL=admin@novarace.local
ADMIN_PASSWORD=change-this-to-a-long-unique-password
# Production: NODE_ENV=production, PUBLIC_ORIGIN=https://flow.example.com
# DATABASE_PATH resolves relative to apps/api when launched with npm scripts.
